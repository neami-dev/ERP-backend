# Copy to .env and fill in. .env is gitignored and must never be committed.

NODE_ENV = 'development'
PORT = 3000

# URL of the frontend, allowed by CORS. Defaults to http://localhost:3001.
FRONTEND_URL = 'http://localhost:3001'

# Database Configuration
DB_HOST = 'localhost'
DB_PORT = 5432
DB_USERNAME =
DB_PASSWORD =
DB_NAME = 'erp_db'

# PGAdmin Configuration
PGADMIN_EMAIL =
PGADMIN_PASSWORD =

# JWT Configuration
# Generate a fresh secret per environment, never reuse the one from another:
#   openssl rand -base64 48
# Anyone holding this value can mint a valid token for any user.
JWT_SECRET =

# How long a token stays valid, e.g. 15m, 12h, 7d.
# There is no refresh token yet, so the user is signed out when this expires.
JWT_EXPIRES_IN = '7d'
